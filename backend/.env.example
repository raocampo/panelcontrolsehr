# ====================================
# panel-control-sujam backend — variables (ejemplo). Copiar a .env.
# ====================================

PORT=5620
DATABASE_URL="postgresql://usuario:password@localhost:5432/panel_control_sujam?schema=public"
JWT_SECRET=cambiar_por_un_valor_aleatorio
FRONTEND_URL=http://localhost:5621

# ── Puente hacia clientes tipoDespliegue = marca_blanca ──
# (nada que configurar aquí: el secreto vive por cliente en clientes.secretoControlPlane)

# ── Puente hacia clientes tipoDespliegue = tenant_corpsimtelec (FASE 6) ──
# API superadmin del backend MULTI-TENANT de SUJAM (no la instancia de un
# cliente marca_blanca).
SUJAM_SUPERADMIN_URL=https://api.sujam.corpsimtelec.com
# Debe ser igual al CONTROL_PLANE_SECRET del backend multi-tenant de SUJAM.
SUJAM_SUPERADMIN_SECRET=
# Dominio base para armar https://{slug}.SUJAM_TENANT_BASE_DOMAIN
SUJAM_TENANT_BASE_DOMAIN=sujam.corpsimtelec.com

# ── Aprovisionamiento de clientes marca_blanca (FASE 6 slice 2) ──
# ⚠️ Crea recursos REALES y facturables en Railway/Vercel al confirmarse
# desde POST /api/clientes/:id/aprovisionar { "confirmar": true }.
# Token de la API pública de Railway. Debe ser un ACCOUNT TOKEN
# (railway.com/account/tokens, elegir "No workspace"), NO un Project Token
# (Project Settings → Tokens) — ese solo autentica dentro de un proyecto y no
# puede crear proyectos nuevos (projectCreate falla con "Not Authorized").
# Verificar con una query { me { id email } } — un Project Token la rechaza.
RAILWAY_API_TOKEN=
# Workspace/team donde deben crearse los proyectos nuevos (para que queden
# junto a sujam/panel-control-sujam y no en el espacio personal del usuario).
# Obtenerlo con { me { workspaces { id name } } }.
RAILWAY_WORKSPACE_ID=
# Imagen de Postgres a usar (misma que sujam/panel-control-sujam en producción).
RAILWAY_POSTGRES_IMAGE=ghcr.io/railwayapp-templates/postgres-ssl:18
# Personal Access Token de Vercel (Account Settings → Tokens).
VERCEL_PERSONAL_ACCESS_TOKEN=
# Solo si el proyecto debe crearse dentro de un team de Vercel (opcional).
VERCEL_TEAM_ID=
# Repo de GitHub del que se despliega cada cliente marca_blanca.
MARCA_BLANCA_REPO=raocampo/SEHR
